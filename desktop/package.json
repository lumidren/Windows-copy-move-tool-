{
  "name": "flingo",
  "productName": "Flingo",
  "version": "0.4.0",
  "description": "Flick photos and files from your Android phone onto your PC.",
  "main": "src/main.js",
  "author": {
    "name": "lumidren",
    "email": "163734075+lumidren@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:overlay": "electron test/overlay-sizes.js",
    "bench": "node bench/bench.js",
    "package": "electron-packager . Flingo --platform=win32 --arch=x64 --out=dist --icon=assets/icon.ico --overwrite --ignore=^/dist --ignore=^/test",
    "dist:win": "npx --yes electron-builder@26 --win --publish never",
    "dist:linux": "npx --yes electron-builder@26 --linux --publish never"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0"
  },
  "homepage": "https://github.com/lumidren/Windows-copy-move-tool-",
  "build": {
    "appId": "com.lumidren.flingo",
    "productName": "Flingo",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Flingo-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "include": "installer/sendto.nsh"
    },
    "linux": {
      "target": [
        "deb",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "flingo",
      "synopsis": "Flick photos from your phone to this PC",
      "artifactName": "flingo-linux.${ext}"
    }
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  }
}
